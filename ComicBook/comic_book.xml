<theme>
    <formatVersion>3</formatVersion>
<!-- Helpsystem menu all views //-->
	<view name="system, basic, detailed, video, grid">

        <helpsystem name="help">
            <textColor>333333</textColor>
 			<fontPath>./art/Shaka_Pow.ttf</fontPath>
			<fontSize>0.027</fontSize>
			<pos>0.030 0.959</pos> 
            <iconColor>333333</iconColor>
        </helpsystem>
        
        <helpsystem name="help" boardModels="rk3328-ha8801">
            <textColor>333333</textColor>
 			<fontPath>./art/Shaka_Pow.ttf</fontPath>
			<fontSize>0.027</fontSize>
			<pos>0.030 0.959</pos> 
            <iconColor>333333</iconColor>           
            <iconUpDown>./art/iconset/joystick_updown.svg</iconUpDown>
            <iconLeftRight>./art/iconset/joystick_leftright.svg</iconLeftRight>
            <iconUpDownLeftRight>./art/iconset/joystick_all.svg</iconUpDownLeftRight>
            <iconA>./art/iconset/a_button.svg</iconA>
            <iconB>./art/iconset/b_button.svg</iconB>
            <iconX>./art/iconset/y_button.svg</iconX>
            <iconY>./art/iconset/x_button.svg</iconY>
            <iconStart>./art/iconset/p1_button.svg</iconStart>
            <iconSelect>./art/iconset/rewind_button.svg</iconSelect>
        </helpsystem>
        <helpsystem name="help" boardModels="rk3328-ha8801" serialNos="8800*, 8801*, 8810*, 8819*">
            <iconL>./art/iconset/c_button.svg</iconL>
            <iconR>./art/iconset/z_button.svg</iconR>
        </helpsystem>
        <helpsystem name="help" boardModels="rk3328-ha8801" serialNos="2810*, 2811*, 2812*, B800*">
            <iconL>./art/iconset/l1_button.svg</iconL>
            <iconR>./art/iconset/r1_button.svg</iconR>
        </helpsystem>
        
	</view>
	
	<view name="system">
	</view>
<!-- End Helpsystem menu all views //-->
<!-- Carousel Feature //-->		
	<feature supported="carousel">

		<view name="system">

			<carousel name="systemcarousel">
				<type>horizontal</type>
				<color>eeeeeecc</color>
				<logoScale>1.5</logoScale>
				<maxLogoCount>3</maxLogoCount>
			</carousel>
		
			<text name="systemInfo">
				<backgroundColor>eeeeeecc</backgroundColor>
				<color>000000</color>
				<fontPath>./art/Shaka_Pow.ttf</fontPath>
				<fontSize>0.035</fontSize>
			</text>
            
            <image name="TopLight" extra="true">
                <pos>0 0</pos>
                <origin>0 0</origin>
                <size>1 1</size>
                <path>./art/top_light.png</path>
                <zIndex>0</zIndex>
            </image>  
            
            <image name="Top" extra="true">
                <pos>0 0</pos>
                <origin>0 0</origin>
                <size>1 1</size>
                <path>./art/top.png</path>
                <zIndex>50</zIndex>
            </image>

            <image name="SystemBackground" extra="true">
                <tile>false</tile>
                <pos>0 0</pos>
                <origin>0 0</origin>
                <size>1 1</size>
                <path>./art/defaultcomic.png</path>
            </image>
            
            <image name="Border" extra="true">
                <tile>false</tile>
                <pos>0 0</pos>
                <origin>0 0</origin>
                <size>1 1</size>
                <path>./art/border.png</path>
            </image>
            
		</view>
	
	</feature>
<!-- End Carousel Feature //-->	
<!-- Background & Gamelist All Views //-->		
	<view name="basic, detailed, video, grid">
	
		<image name="background">
			<tile>false</tile>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<size>1 1</size>
			<path>./art/menu.png</path>
		</image>
        
        <image name="Top" extra="true">
            <pos>0 0</pos>
            <origin>0 0</origin>
            <size>1 1</size>
            <path>./art/top.png</path>
            <zIndex>50</zIndex>
        </image>        
		
		<textlist name="gamelist">
			<selectorColor>33333399</selectorColor>
			<selectedColor>eeeeee</selectedColor>
			<primaryColor>000000</primaryColor>
			<secondaryColor>000000</secondaryColor>
			<fontPath>./art/Shaka_Pow.ttf</fontPath>
			<forceUppercase>0</forceUppercase>
			<pos>0.014 0.198</pos>
			<size>0.478 0.7495</size>
			<alignment>center</alignment>
			<horizontalMargin>0.00</horizontalMargin>
			<fontSize>0.0335</fontSize>
			<scrollSound>./art/scroll.wav</scrollSound>
		</textlist>
        <imagegrid name="gamegrid">
            <pos>0.035 0.215</pos>
            <size>0.42 0.72</size>
            <margin>0.02 0.02</margin>
            <autoLayout>3 4</autoLayout>
            <animate>true</animate>
            <scrollDirection>vertically</scrollDirection>
            <centerSelection>false</centerSelection>
            <scrollLoop>false</scrollLoop>
            <imageSource>thumbnail</imageSource>	
        </imagegrid>
        <gridtile name="default">
            <backgroundColor>FFFFFF00</backgroundColor>
            <backgroundCornerSize>9 9</backgroundCornerSize>
            <padding>9 9</padding>
            <textColor>000000FF</textColor>
            <imageColor>FFFFFFFF</imageColor>
        </gridtile>
        <gridtile name="selected">
            <backgroundColor>3082cec0</backgroundColor>
            <textColor>FFFFFFFF</textColor>
            <imageColor>FFFFFFFF</imageColor>
        </gridtile>
		
	</view>
<!-- End Background & Gamelist All Views //-->
<!-- View Specific Image Placement //-->
	<view name="basic">
            <image name="basics" extra="true">
				<pos>0.672 0.43</pos>
				<origin>0.5 0.5</origin>
				<maxSize>0.32 0.42</maxSize>
                <path>./art/basic.png</path>
                <zIndex>4</zIndex>        
            </image>       
	</view>

	<view name="detailed">

		<image name="md_image">
			<pos>0.672 0.43</pos>
			<maxSize>0.32 0.42</maxSize>
			<origin>0.5 0.5</origin>
		</image>
		
	</view>
	
	<feature supported="video">
	
		<view name="video">
	
			<video name="md_video">
				<pos>0.672 0.43</pos>
				<origin>0.5 0.5</origin>
				<maxSize>0.32 0.42</maxSize>
				<delay>0.5</delay>
                <showSnapshotNoVideo>false</showSnapshotNoVideo>
                <showSnapshotDelay>true</showSnapshotDelay>
                <createSnapshot>false</createSnapshot>
                <snapshotSource>image</snapshotSource>
			</video>
            <image name="md_image">
				<pos>0.672 0.43</pos>
				<origin>0.5 0.5</origin>
				<maxSize>0.32 0.42</maxSize>
                <default>./art/nopic2.png</default>
                <zIndex>4</zIndex>        
            </image>		
			<image name="md_marquee">
				<pos>1 1</pos>
				<maxSize>0 0</maxSize>
				<origin>0 0</origin>
			</image>
			
			<image name="md_thumbnail">
				<pos>0.918 0.555</pos>
				<maxSize>0.127 0.17</maxSize>
				<origin>0.5 0.5</origin>
			</image>
		
		</view>
		
        <view name="grid">
	
			<video name="md_video">
				<pos>0.672 0.43</pos>
				<origin>0.5 0.5</origin>
				<maxSize>0.32 0.42</maxSize>
				<delay></delay>
				<default></default>
				<showSnapshotNoVideo>true</showSnapshotNoVideo>
				<showSnapshotDelay>false</showSnapshotDelay>
                <snapshotSource>image</snapshotSource>
			</video>
		
			<image name="md_marquee">
				<pos>1 1</pos>
				<maxSize>0 0</maxSize>
				<origin>0 0</origin>
			</image>
			
			<image name="md_image">
				<pos>0.918 0.555</pos>
				<maxSize>0.127 0.17</maxSize>
				<origin>0.5 0.5</origin>
			</image>
		
		</view>
        
        
	</feature>
<!-- End View Specific Image Placement //-->
<!-- Meta Data //-->	
